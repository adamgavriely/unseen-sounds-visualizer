# Environment variables the code reads. Export them in your shell: main.py also loads a .env file, but only after
# the listener inputs are prepared, so the paths below must be in the shell environment. Defaults are in brackets.

# Python of the second environment with transformers 4.51.3, used for FineLAP [~/venv_flap/bin/python]
FINELAP_PYTHON=/path/to/venv_flap/bin/python
# FlexSED repository folder [~/FlexSED]
FLEXSED_ROOT=/path/to/FlexSED
# Transformer4SED repository folder with the DASM weights and third_parties/MGA-CLAP [~/Transformer4SED]
T4SED_ROOT=/path/to/Transformer4SED
# local copy of bert-base-uncased used by DASM's text encoder [~/bert-base-uncased]
BERT_DIR=/path/to/bert-base-uncased
# Hugging Face token, for gated models (read by huggingface_hub)
HF_TOKEN=

# Optional
# PretrainedSED repository folder, only for the PSED detector variant [~/PretrainedSED]
# PSED_ROOT=/path/to/PretrainedSED
# project folder, if the ComfyUI nodes are installed outside it [parent of comfyui_nodes/]
# MSCPROJ_ROOT=/path/to/MscFinalProject
# ComfyUI folder for comfyui_nodes/comfy_start.py [~/ComfyUI]
# COMFYUI_ROOT=/path/to/ComfyUI
# cluster checkouts that some scoring-harness variants read files from [/home/dsi/adamg/MscProj, ..._tg]
# MSCPROJ_MAIN_CHECKOUT=/path/to/MscProj
# MSCPROJ_TG_CHECKOUT=/path/to/MscProj_tg

# Set by the scoring harness itself (no need to set them by hand)
# TG_ARMS: variants that benchmark/gold/tagger_prep.py runs, space-separated
# TG_EXTRA_SPLITS: extra one-clip splits for tagger_prep.py (set by src/listener_prep.py)
# R13_LOCAL: local output folder for benchmark/gold/round13_dev.py
# R13_SHARD: "i/n", run every n-th clip in round13_dev.py
# TRAIL_DEV_ROOT: DEV output folder read by benchmark/gold/inspector_trail_export.py
