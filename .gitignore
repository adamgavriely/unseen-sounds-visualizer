# Local tool settings and secrets
.claude/
.env
.venv/

# Python
__pycache__/
*.pyc

# Pipeline intermediates and outputs (regenerated by the pipeline)
data/work/
data/output/

# Input videos: keep only the small test clip
data/input/*
!data/input/.gitkeep
!data/input/clip.mp4

# Large caches rebuilt by the scoring harness
benchmark/gold/gate_gold/
benchmark/gold/beats_fw/
benchmark/gold/beats_cam_memo.pkl
docs/inspector/media/

# Cluster job output
logs/
*.out
*.err

# LaTeX build files
*.aux
*.bbl
*.blg
*.log
*.toc
*.fdb_latexmk
*.fls
*.synctex.gz

# Local archive of removed material, archives and shortcuts
archive/
*.zip
*.lnk
