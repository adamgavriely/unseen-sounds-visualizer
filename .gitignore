# Claude Code local settings (machine-local, not shared)
.claude/settings.local.json

# Python
__pycache__/
*.pyc
.venv/
.env

# Pipeline artifacts (regenerated by the pipeline)
data/work/
data/output/

# LaTeX build artifacts (regenerated from docs/*.tex)
docs/*.aux
docs/*.bbl
docs/*.blg
docs/*.log
docs/*.out
docs/*.toc
docs/*.synctex.gz
# compiled deliverable PDFs ARE tracked (process documentation)
docs/*.pdf
!docs/project_notes.pdf
!docs/literature_review.pdf

# Input videos: keep only the small synthetic test clip; ignore downloaded videos.
data/input/*
!data/input/.gitkeep
!data/input/clip.mp4

# tagger backup
benchmark/tags.json.bak
benchmark/suggestions.json
data/work/audioset/*.tsv
docs/report/*.aux
docs/report/*.log
docs/report/*.out
docs/report/*.toc
benchmark/gold/gate_gold/
benchmark/gold/beats_fw/
benchmark/gold/beats_cam_memo.pkl
