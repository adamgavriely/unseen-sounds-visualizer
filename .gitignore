# Local tool settings and secrets
.claude/
.env
.venv/

# Python
__pycache__/
*.pyc

# Pipeline intermediates and outputs (regenerated by the pipeline)
data/work/
data/output/

# Input videos: keep only the small test clip
data/input/*
!data/input/.gitkeep
!data/input/clip.mp4

# Per-clip inputs that main.py builds for a new video (src/listener_prep.py)
benchmark/gold/live_*

# Cluster job output
logs/
*.out
*.err

# LaTeX build files
*.aux
*.bbl
*.blg
*.log
*.toc
*.fdb_latexmk
*.fls
*.synctex.gz

# Local archive of removed material, archives and shortcuts
archive/
*.zip
*.lnk
